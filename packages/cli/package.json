{
  "name": "@autospine/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "autospine": "./dist/index.js"
  },
  "exports": {
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./character": {
      "types": "./dist/character.d.ts",
      "import": "./dist/character.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@autospine/assets": "0.0.0",
    "@autospine/character": "0.0.0",
    "@autospine/mesh": "0.0.0",
    "@autospine/motion": "0.0.0",
    "@autospine/pipeline": "0.0.0",
    "@autospine/reference": "0.0.0",
    "@autospine/rig": "0.0.0",
    "@autospine/schemas": "0.0.0",
    "@autospine/spine": "0.0.0",
    "@sinclair/typebox": "^0.34.52",
    "pngjs": "^7.0.0"
  }
}
