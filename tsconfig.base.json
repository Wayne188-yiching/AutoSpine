{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "paths": {
      "@autospine/core": ["./packages/core/src/index.ts"],
      "@autospine/schemas": ["./schemas/src/index.ts"],
      "@autospine/spine": ["./packages/spine/src/index.ts"],
      "@autospine/assets": ["./packages/assets/src/index.ts"],
      "@autospine/mesh": ["./packages/mesh/src/index.ts"],
      "@autospine/rig": ["./packages/rig/src/index.ts"],
      "@autospine/weights": ["./packages/weights/src/index.ts"],
      "@autospine/motion": ["./packages/motion/src/index.ts"],
      "@autospine/pipeline": ["./packages/pipeline/src/index.ts"],
      "@autospine/constraints": ["./packages/constraints/src/index.ts"],
      "@autospine/planning": ["./packages/planning/src/index.ts"],
      "@autospine/cli/build": ["./packages/cli/src/build.ts"],
      "@autospine/mcp": ["./packages/mcp/src/index.ts"]
    }
  }
}
